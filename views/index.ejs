<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Homepage</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <%- include("partials/header.ejs") %>


    <div id="body">

        <!-- ====================
             Welcome Section
        ========================= -->

        <div class="welcome">

            <h1 class="header">
                Welcome to My Blog
            </h1>

            <p>
                Thoughts, stories and ideas.
            </p>

            <h4>
                <a href="/create">
                    Create a new post
                </a>
            </h4>

        </div>


        <!-- ====================
             Latest Posts
        ========================= -->

        <div class="latest-post">

            <h4>
                Latest Posts
            </h4>


            <div class="postcard-container">

                <% if (latestPosts.length > 0) { %>

                    <% latestPosts.forEach((Lpost) => { %>

                        <div class="post-card">

                            <!-- Post Image -->

                            <div class="post-image">

                                <% if (Lpost.image) { %>

                                    <img
                                        src="<%= Lpost.image %>"
                                        alt="Post image"
                                    >

                                <% } else { %>

                                    <div class="post-image-placeholder">
                                        <span>No Image</span>
                                    </div>

                                <% } %>

                            </div>


                            <!-- Post Content -->

                            <div class="post-content">

                                <p class="post-category">
                                    <%= Lpost.category %>
                                </p>


                                <h2>
                                    <%= Lpost.title %>
                                </h2>


                                <p class="post-excerpt">
                                    <%= Lpost.content %>
                                </p>


                                <!-- Post Information -->

                                <div class="post-info">

                                    <span>
                                        By <%= Lpost.author %>
                                    </span>

                                    <span>
                                        •
                                    </span>

                                    <span>
                                        <%= Lpost.date %>
                                    </span>

                                </div>


                                <!-- Read More -->

                                <a
                                    href="/single-post/<%= Lpost.id %>"
                                    class="read-more"
                                >
                                    Read article
                                    <span aria-hidden="true">→</span>
                                </a>

                            </div>

                        </div>

                    <% }) %>


                <% } else { %>


                    <!-- Empty State -->

                    <div class="empty-post">

                        <h3>
                            No posts yet
                        </h3>

                        <p>
                            I'm working on something new.
                            Check back soon for the latest stories and ideas.
                        </p>

                    </div>


                <% } %>

            </div>


            <!-- View All Posts -->

            <p class="view">

                <a href="/all-post">
                    View all posts
                </a>

            </p>

        </div>


        <!-- ====================
             Newsletter
        ========================= -->



            <section class="newsletter-section">

                <div class="container">

                    <div class="newsletter">


                        <!-- Newsletter Content -->

                        <div class="newsletter-content">

                            <span class="eyebrow">
                                STAY CONNECTED
                            </span>


                            <h2>
                                Get new posts and updates delivered
                                straight to your inbox.
                            </h2>


                            <p>
                                No noise. Just useful ideas, lessons,
                                and stories worth reading.
                            </p>

                        </div>


                        <!-- Newsletter Form -->

                        <form class="newsletter-form">

                            <label
                                for="email"
                                class="sr-only"
                            >
                                Email address
                            </label>


                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="Your email address"
                                required
                            >


                            <button type="submit">
                                Subscribe
                            </button>

                        </form>

                    </div>

                </div>

            </section>

      



        <!-- ====================
             Newsletter
        ========================= -->

        <div class="span">

            <span class="line"></span>

            <div class="newsletter2">

               <img class="newsletter-logo" src="/newsletter logo.png">

               <div class=" newsletter2-content">
                <p>
                    Get the latest posts delivered straight to your inbox.
                </p>

                <form>

                    <input
                        type="email"
                        name="email"
                        placeholder="Your email address"
                        required
                    >

                    <button type="submit">
                        Subscribe
                    </button>

                </form>
               </div>
            </div>

            <span class="line"></span>

        </div>

    </div>

    </div>


    <%- include("partials/footer.ejs") %>

</body>

</html>